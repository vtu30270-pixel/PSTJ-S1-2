import java.util.*;

public class Main {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            String s = sc.next();

            int n = s.length();
            int[] freqLeft = new int[26];
            int[] freqRight = new int[26];

            // First half
            for (int i = 0; i < n / 2; i++) {
                freqLeft[s.charAt(i) - 'a']++;
            }

            // Second half
            // Skip the middle character if length is odd
            for (int i = (n + 1) / 2; i < n; i++) {
                freqRight[s.charAt(i) - 'a']++;
            }

            boolean isLapindrome = true;

            for (int i = 0; i < 26; i++) {
                if (freqLeft[i] != freqRight[i]) {
                    isLapindrome = false;
                    break;
                }
            }

            System.out.println(isLapindrome ? "YES" : "NO");
        }

        sc.close();
    }
}
