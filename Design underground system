import java.util.*;

class UndergroundSystem {

    // id -> check-in station and time
    Map<Integer, String> station = new HashMap<>();
    Map<Integer, Integer> time = new HashMap<>();

    // route -> [total time, number of trips]
    Map<String, double[]> data = new HashMap<>();

    public UndergroundSystem() {
        
    }

    public void checkIn(int id, String stationName, int t) {
        station.put(id, stationName);
        time.put(id, t);
    }

    public void checkOut(int id, String stationName, int t) {

        String start = station.get(id);
        int startTime = time.get(id);

        int travelTime = t - startTime;

        String route = start + "->" + stationName;

        if (!data.containsKey(route)) {
            data.put(route, new double[]{0, 0});
        }

        data.get(route)[0] += travelTime; // total time
        data.get(route)[1] += 1;          // number of trips

        station.remove(id);
        time.remove(id);
    }

    public double getAverageTime(String startStation, String endStation) {

        String route = startStation + "->" + endStation;

        double[] result = data.get(route);

        return result[0] / result[1];
    }
}
